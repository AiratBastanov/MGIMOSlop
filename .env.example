# Пример переменных окружения Linux; значения заменить локально, файл с секретами не публиковать.
DJANGO_SETTINGS_MODULE=deanery.settings.production
DJANGO_SECRET_KEY=<random-secret>
DJANGO_ALLOWED_HOSTS=<host.example>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<host.example>
DJANGO_SECURE_HSTS_SECONDS=3600
# Только один Caddy на том же узле; Gunicorn слушает 127.0.0.1:8000.
DJANGO_CLIENT_IP_TRUSTED_PROXY=127.0.0.1
DB_NAME=<database>
DB_USER=<database-role>
DB_PASSWORD=<local-password>
DB_HOST=127.0.0.1
DB_PORT=5432

# По умолчанию письма только сохраняются локально в .local/captured-email.
EMAIL_BACKEND=notifications.mail_backend.CaptureBackend
MAIL_EXTERNAL_ENABLED=0
PUBLIC_BASE_URL=http://127.0.0.1:8000
# Для отдельно разрешённой внешней доставки: SMTP backend + MAIL_EXTERNAL_ENABLED=1,
# PUBLIC_BASE_URL=https://<host.example>, EMAIL_HOST/PORT/HOST_USER/HOST_PASSWORD/USE_TLS.
# Наличие SMTP credentials само по себе не разрешает отправку.

# Навигационный помощник: без этих настроек работает проверенная FAQ-справка.
# Только уже установленная локальная модель; ничего не скачивается автоматически.
SUPPORT_PROVIDER=
SUPPORT_ENDPOINT=http://127.0.0.1:11434
SUPPORT_MODEL=
SUPPORT_LOCAL_ONLY_CONFIRMED=0
# Для отдельно запускаемого Ollama: OLLAMA_HOST=127.0.0.1:11434; OLLAMA_NO_CLOUD=1.

# Предельные размеры вложений прототипа; преподаватель может ужесточить политику.
MATERIAL_ATTACHMENT_COUNT=5
MATERIAL_ATTACHMENT_FILE_BYTES=10485760
MATERIAL_ATTACHMENT_TOTAL_BYTES=26214400
